<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shares the same App Group T26's GuardianContentBlocker uses, so this extension can
	     write pending app_usage events for the main app (ScreenTimeModule) to drain. Also
	     requires the com.apple.developer.family-controls entitlement (see
	     ScreenTimeAuthorization.swift's header comment) on the MAIN app target — a
	     DeviceActivityMonitor extension target itself does not need family-controls directly,
	     only the app that calls DeviceActivityCenter.startMonitoring does. Requires an Apple
	     Developer account (T27's human_gate) before this is a real, provisionable entitlement. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.guardian.app</string>
	</array>
</dict>
</plist>
