<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- T22: Layer-1 VPN DNS filter (spec §4) — foreground-service notification + FGS
         declarations GuardianVpnService needs to run as a persistent foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- T23: Layer-3 AccessibilityService block overlay (spec §4). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- T24: UsageAccountant's foreground-app polling (spec §3.7/§7). Protected permission —
         not requestable at runtime; the user must grant it via Settings.ACTION_USAGE_ACCESS_
         SETTINGS (UsageAccountant.hasUsageAccess()), the same class of user-grantable special
         access as SYSTEM_ALERT_WINDOW above. tools:ignore suppresses the lint warning for a
         permission the app deliberately cannot request through the normal runtime-permission
         dialog. -->
    <uses-permission
      android:name="android.permission.PACKAGE_USAGE_STATS"
      tools:ignore="ProtectedPermissions" />
    <!-- T25: Level 2 CameraPresenceService (spec §6) — front-camera presence sampling +
         its foreground-service declaration (Play Store requirement, spec §8). CAMERA is a
         normal dangerous runtime permission requested from JS via the standard RN permissions
         flow (no native bridge method needed for the request itself, unlike SYSTEM_ALERT_WINDOW/
         PACKAGE_USAGE_STATS above which have no runtime-request dialog at all). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- T22: Layer-1 VPN DNS filter. BIND_VPN_SERVICE restricts binding to the system itself,
           per VpnService's own documented contract. A local VPN + notification permission both
           trigger a Play Store data-safety/prominent-disclosure requirement -- see T28 compliance
           doc, not duplicated here. -->
      <service
        android:name="com.guardian.vpn.GuardianVpnService"
        android:exported="false"
        android:permission="android.permission.BIND_VPN_SERVICE"
        android:foregroundServiceType="specialUse">
        <intent-filter>
            <action android:name="android.net.VpnService" />
        </intent-filter>
        <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Parental-control DNS content filtering VPN" />
      </service>

      <!-- T23: Layer-3 AccessibilityService (spec §4) — on-screen text scanning + YouTube
           capture + tamper (accessibility-disable) signal. canRetrieveWindowContent is required
           for getRootInActiveWindow()/node-tree traversal. A local accessibility service that
           reads on-screen text triggers a Play Store data-safety/prominent-disclosure
           requirement -- see T28 compliance doc, not duplicated here. -->
      <service
        android:name="com.guardian.accessibility.GuardianAccessibilityService"
        android:exported="false"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
        android:label="@string/accessibility_service_label">
        <intent-filter>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent-filter>
        <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/accessibility_service_config" />
      </service>

      <!-- T24: Device Admin uninstall protection (spec §3.7). BIND_DEVICE_ADMIN restricts
           binding to the system itself, per DeviceAdminReceiver's own documented contract.
           Uninstall protection + lock-device capability trigger a Play Store data-safety/
           prominent-disclosure requirement -- see T28 compliance doc, not duplicated here. -->
      <receiver
        android:name="com.guardian.deviceadmin.GuardianDeviceAdminReceiver"
        android:exported="true"
        android:permission="android.permission.BIND_DEVICE_ADMIN">
        <meta-data
          android:name="android.app.device_admin"
          android:resource="@xml/device_admin_policies" />
        <intent-filter>
            <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        </intent-filter>
      </receiver>

      <!-- T24: new-app-install alert (spec §3.3). PACKAGE_ADDED is exempt from Android 8+'s
           implicit-broadcast restrictions, so a manifest-registered receiver still works. -->
      <receiver
        android:name="com.guardian.usage.PackageAddedReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.PACKAGE_ADDED" />
            <data android:scheme="package" />
        </intent-filter>
      </receiver>

      <!-- T25: Level 2 front-camera presence check (spec §6). foregroundServiceType="camera" is
           the Play Store requirement spec §8 names for any service using the camera in the
           background. A local presence-sensing feature that samples the camera triggers a Play
           Store data-safety/prominent-disclosure requirement -- see T28 compliance doc, not
           duplicated here. Gated in code (CameraPresenceService.onStartCommand) on level2Enabled
           AND on-device opt-in -- see this ticket's report for the privacy guardrail checklist. -->
      <service
        android:name="com.guardian.presence.CameraPresenceService"
        android:exported="false"
        android:foregroundServiceType="camera" />
    </application>
</manifest>
